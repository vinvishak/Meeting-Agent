# Jira Cloud REST API
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-atlassian-api-token-here

# Copilot MCP Server (Meeting Agent → copilot_mcp wrapper)
COPILOT_MCP_URL=http://localhost:3001
COPILOT_MCP_TOKEN=your-copilot-mcp-token-here

# Copilot MCP Wrapper — Azure App Registration
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-azure-client-secret-here

# Copilot MCP Wrapper — Server settings
MCP_HOST=0.0.0.0
MCP_PORT=3001
MCP_TOKEN=your-shared-secret-here
TRANSCRIPT_LOOKBACK_DAYS=7

# Claude API (for NL queries and semantic embedding matching)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# Sync settings
SYNC_INTERVAL_MINUTES=15
STALE_THRESHOLD_DAYS=10
# Comma-separated Jira project/board keys to sync (e.g. PROJ,INFRA,PLAT)
JIRA_PROJECT_KEYS=

# Update suggestion thresholds
HIGH_CONFIDENCE_THRESHOLD=0.90
AUTO_APPLY_ENABLED=false

# GitHub integration
# PAT for polling GitHub REST API (periodic sync)
GITHUB_PAT=your-github-pat-here
GITHUB_ORG=your-github-org
GITHUB_REPOS=
# Webhook secret — set the same value in GitHub → repo Settings → Webhooks → Secret
# Leave empty to skip HMAC validation (dev/local only; always set in production)
GITHUB_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=INFO
